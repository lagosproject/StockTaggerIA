# ==============================================================================
# StockTaggerIA - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or real API keys to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Configuration (Required for direct AI Vision tagging)
# ------------------------------------------------------------------------------
# Obtain your Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default Gemini model.
# StockTaggerIA automatically discovers and negotiates the best available multimodal model:
# (Priority: gemini-3.6-flash -> gemini-2.5-flash -> gemini-2.0-flash -> gemini-1.5-flash)
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 2. ExifTool Engine Configuration (Optional)
# ------------------------------------------------------------------------------
# StockTaggerIA automatically detects ExifTool from system PATH, local directory,
# or standard installation paths. Set this variable if using a custom location.
#
# Windows Example:
# EXIFTOOL_PATH=C:\Program Files\ExifTool\exiftool.exe
#
# Linux / macOS Example:
# EXIFTOOL_PATH=/usr/local/bin/exiftool
EXIFTOOL_PATH=

# ------------------------------------------------------------------------------
# 3. Default Execution Preferences (Optional)
# ------------------------------------------------------------------------------
# Default folder containing photos to tag (fallback is current directory '.')
DEFAULT_PHOTOS_DIR=

# Default stock platform preset:
#   - stock   : Optimized for Unsplash & Pexels (up to 30 SEO tags)
#   - pixabay : Optimized for Pixabay (up to 25 tags)
DEFAULT_PLATFORM=stock

# Default language for SEO metadata generation:
#   - en : English (primary stock standard)
#   - es : Spanish
#   - fr : French
DEFAULT_LANG=en
